SECURL_HTTP_ADDR=:8080
# Use SECURL_HTTP_ADDR=unix:/absolute/path.sock for a Unix socket. Explicit Unix sockets take precedence over PORT.
# Enable only when stdin is a lifetime pipe owned by a supervising parent process.
SECURL_EXIT_ON_STDIN_EOF=false
SECURL_PUBLIC_ORIGINS=http://localhost:8080
SECURL_STORE_BACKEND=memory
SECURL_POSTGRES_URL=
SECURL_MARIADB_DSN=
SECURL_FRONTEND_MODE=embedded
SECURL_CORS_ALLOWED_ORIGINS=
SECURL_ALLOWED_TTLS=1h,24h,168h,720h,forever
SECURL_DEFAULT_TTL=168h
SECURL_CLEANUP_INTERVAL=1m
SECURL_CLEANUP_BATCH=500
SECURL_MAX_ENVELOPE_BYTES=16384
SECURL_SAFE_BROWSING_ENABLED=false
SECURL_SAFE_BROWSING_API_KEY=
SECURL_SAFE_BROWSING_TIMEOUT=3s
SECURL_SAFE_BROWSING_CACHE_ENTRIES=4096
SECURL_CAPTCHA_PROVIDER=none
SECURL_CREATE_CAPTCHA_REQUIRED=false
SECURL_CAPTCHA_SITE_KEY=
SECURL_CAPTCHA_SECRET_KEY=
SECURL_CAPTCHA_WRAP_KEY=
SECURL_CAPTCHA_ALLOWED_HOSTNAMES=localhost
SECURL_ENABLE_HSTS=false
