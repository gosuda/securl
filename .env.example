# SecURL loads this file when the standalone command starts.
# Values already present in the process environment take precedence.

# Server
SECURL_HTTP_ADDR=:8080
SECURL_EXIT_ON_STDIN_EOF=false
SECURL_PUBLIC_ORIGINS=http://localhost:8080
SECURL_FRONTEND_MODE=embedded
SECURL_CORS_ALLOWED_ORIGINS=
SECURL_ENABLE_HSTS=false

# PaaS listener variables. PORT overrides a TCP SECURL_HTTP_ADDR.
# An explicit unix:/absolute/path.sock address still takes precedence.
# PORT=8080
# HOST=0.0.0.0
# IP=127.0.0.1

# Storage
SECURL_STORE_BACKEND=memory
SECURL_POSTGRES_URL=
SECURL_MARIADB_DSN=
SECURL_MAX_ENVELOPE_BYTES=6144

# Link lifetime and cleanup
SECURL_ALLOWED_TTLS=1h,24h,168h,720h,forever
SECURL_DEFAULT_TTL=168h
SECURL_CLEANUP_INTERVAL=1m
SECURL_CLEANUP_BATCH=500

# Google Safe Browsing
SECURL_SAFE_BROWSING_ENABLED=false
SECURL_SAFE_BROWSING_API_KEY=
SECURL_SAFE_BROWSING_TIMEOUT=3s
SECURL_SAFE_BROWSING_CACHE_ENTRIES=4096

# CAPTCHA
SECURL_CAPTCHA_PROVIDER=none
SECURL_CREATE_CAPTCHA_REQUIRED=false
SECURL_CAPTCHA_SITE_KEY=
SECURL_CAPTCHA_SECRET_KEY=
SECURL_CAPTCHA_WRAP_KEY=
SECURL_CAPTCHA_ALLOWED_HOSTNAMES=localhost

# Frontend build and database contract tests. These are not runtime server settings.
# PUBLIC_SECURL_API_BASE_URL=https://api.example.com
# TEST_POSTGRES_URL=postgres://securl:password@localhost:5432/securl
# TEST_MARIADB_DSN=securl:password@tcp(localhost:3306)/securl

# Used only by node cmd/securl/run.js. Defaults to cmd/securl/securl.
# SECURL_BINARY_PATH=./bin/securl
